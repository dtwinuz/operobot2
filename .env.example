# operobot2 (docs/06-deploy.md). Copy to the server as <remote-dir>/.env. Never commit real values.
DB_PASSWORD=
PUBLIC_URL=https://operobot2.dtwin.uz
DEMO=true
SIGNUP=open

# AI: OpenAI-compatible chat/completions. Empty = rule-based Uzbek responder.
LLM_URL=
LLM_KEY=
LLM_MODEL=gpt-4o-mini

# Payments. Empty = only demo orgs can "pay".
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=

# operobot dialer bridge (docs/05). Empty = calls simulated for demo orgs only.
DIALER_URL=
DIALER_TOKEN=
